// glint_math against known values.
import "std/io";
import "glint/glint_math";

var fails: int32 = 0;

fn eq(name: string, a: float32, b: float32) {
  var d: float32 = a - b;
  if (d < 0.0) { d = -d; }
  if (d < 0.0001) { return; }
  println("FAIL {name}: {a} != {b}");
  fails += 1;
}

fn main() -> int32 {
  eq("sqrt 2", glint_sqrt(2.0), 1.4142135);
  eq("sqrt 0.25", glint_sqrt(0.25), 0.5);
  eq("sin pi/6", glint_sin(GLINT_PI / 6.0), 0.5);
  eq("sin -7", glint_sin(-7.0), -0.6569866);
  eq("cos 0", glint_cos(0.0), 1.0);
  eq("cos 100", glint_cos(100.0), 0.8623189);
  eq("tan pi/4", glint_tan(GLINT_PI / 4.0), 1.0);
  var c: GlintVec3 = glint_vec3_cross(glint_vec3(1.0, 0.0, 0.0), glint_vec3(0.0, 1.0, 0.0));
  eq("cross z", c.z, 1.0);
  // rotate (1,0,0) by 90 degrees around z, then translate by (1,2,3): (1,3,3)
  var m: GlintMat4 = glint_mat4_mul(glint_mat4_translate(glint_vec3(1.0, 2.0, 3.0)),
                                    glint_mat4_rotate(glint_radians(90.0), glint_vec3(0.0, 0.0, 1.0)));
  eq("rotate+translate x", m.m[0] + m.m[12], 1.0);
  eq("rotate+translate y", m.m[1] + m.m[13], 3.0);
  eq("rotate+translate z", m.m[2] + m.m[14], 3.0);
  // look_at from (0,0,5) to the origin puts the origin at z = -5 in view space
  var v: GlintMat4 = glint_mat4_look_at(glint_vec3(0.0, 0.0, 5.0), glint_vec3(0.0, 0.0, 0.0), glint_vec3(0.0, 1.0, 0.0));
  eq("look_at z", v.m[14], -5.0);
  var p: GlintMat4 = glint_mat4_perspective(glint_radians(90.0), 1.0, 1.0, 3.0);
  eq("perspective f", p.m[5], 1.0);
  eq("perspective m10", p.m[10], -2.0);
  eq("perspective m14", p.m[14], -3.0);
  if (fails != 0) { return 1; }
  println("ok");
  return 0;
}
