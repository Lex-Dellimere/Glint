// Linux part of the window test, on a private Xvfb: Glint's own window (EGL
// and GLX) and a window the app made itself (EGL and GLX).
import "std/io";
import "glint/glint";
import "xvfb";
import "window_common";
import "glint/glint_preview";

extern fn wt_dlopen(path: cstring, flags: int32) -> rawptr = "dlopen";
extern fn wt_dlsym(h: rawptr, name: cstring) -> rawptr = "dlsym";

export fn wt_main() -> int32 {
  if (!xvfb_start()) { println("FAIL no Xvfb"); return 1; }
  own_window(GLINT_BACKEND_EGL, "own window EGL");
  own_window(GLINT_BACKEND_GLX, "own window GLX");

  // A window made by "the app", with plain Xlib.
  var x: rawptr = wt_dlopen("libX11.so.6", 2);
  var open: fn(cstring) -> rawptr = (fn(cstring) -> rawptr)wt_dlsym(x, "XOpenDisplay");
  var root: fn(rawptr, int32) -> int64 = (fn(rawptr, int32) -> int64)wt_dlsym(x, "XDefaultRootWindow");
  var mk: fn(rawptr, int64, int32, int32, uint32, uint32, uint32, int64, int64) -> int64 = (fn(rawptr, int64, int32, int32, uint32, uint32, uint32, int64, int64) -> int64)wt_dlsym(x, "XCreateSimpleWindow");
  var map: fn(rawptr, int64) -> int32 = (fn(rawptr, int64) -> int32)wt_dlsym(x, "XMapWindow");
  var sync: fn(rawptr, int32) -> int32 = (fn(rawptr, int32) -> int32)wt_dlsym(x, "XSync");
  var dpy: rawptr = open((cstring)0);
  var xid: int64 = mk(dpy, root(dpy, 0), 0, 0, 120, 90, 0, 0, 0);
  map(dpy, xid);
  sync(dpy, 0);
  var vid: int64 = 0;
  var depth: int32 = 0;
  check("glint_x11_visual", glint_x11_visual((GlintConfig*)0, &vid, &depth) && vid != 0 && depth >= 24);
  println("     visual 0x{vid} depth {depth}");
  bad_handle(GLINT_BACKEND_EGL, "existing EGL", 0x7FFFFFF0);
  bad_handle(GLINT_BACKEND_GLX, "existing GLX", 0x7FFFFFF0);
  existing_window(GLINT_BACKEND_EGL, "existing EGL", xid);
  existing_window(GLINT_BACKEND_GLX, "existing GLX", xid);

  // a preview docked on the right of the 640x480 screen: 256 wide, full height
  var pv: GlintPreview* = glint_preview_open("preview", 0, 0, GLINT_DOCK_RIGHT);
  check("preview opens docked", pv != 0);
  if (pv != 0) {
    var wa: uint8[256];
    var attrs: fn(rawptr, int64, uint8*) -> int32 = (fn(rawptr, int64, uint8*) -> int32)wt_dlsym(x, "XGetWindowAttributes");
    sync(pv->ctx->x_dpy, 0);
    attrs(pv->ctx->x_dpy, pv->ctx->win, &wa[0]);
    var wx: int32 = *(int32*)(&wa[0]);
    var ww: int32 = *(int32*)(&wa[0] + 8);
    var wh: int32 = *(int32*)(&wa[0] + 12);
    println("     preview window at x {wx}, {ww}x{wh}");
    check("docked right: 256x480 at x 384", wx == 384 && ww == 256 && wh == 480);
    check("preview frame", glint_preview_begin(pv));
    glClearColor(0.0, 1.0, 0.0, 1.0);
    glClear(GL_COLOR_BUFFER_BIT);
    glint_preview_end(pv, true);
    check("preview no GL error", glGetError() == 0);
    glint_preview_close(pv);
  }
  // probes keep their connection; the next open uses it
  var vid2: int64 = 0;
  var d2: int32 = 0;
  var sw: int32 = 0;
  var sh: int32 = 0;
  check("probe twice + screen size", glint_x11_visual((GlintConfig*)0, &vid2, &d2) && glint_x11_visual((GlintConfig*)0, &vid2, &d2) && glint_screen_size(&sw, &sh) && sw == 640);
  existing_window(GLINT_BACKEND_EGL, "existing after probes", xid);

  // the X server dies under a live window: Glint reports a lost context and
  // the program keeps running (Xlib would otherwise exit)
  var cfg: GlintConfig = glint_config();
  cfg.robust = true;
  var closed: fn(rawptr) -> int32 = (fn(rawptr) -> int32)wt_dlsym(x, "XCloseDisplay");
  closed(dpy);                  // the test's own plain-Xlib connection would exit the program
  var live: GlintContext* = glint_open_window("dies", 64, 64, &cfg);
  check("window before the server dies", live != 0);
  xvfb_stop();
  if (live != 0) {
    var ev: GlintEvent;
    var t0: float64 = glint_time();
    var swapped: bool = true;
    while (glint_time() - t0 < 0.5) {
      while (glint_poll(live, &ev)) { }
      glClear(GL_COLOR_BUFFER_BIT);
      swapped = glint_swap(live);
    }
    check("swap fails after the server died", !swapped);
    check("context reported lost", glint_context_lost(live));
    glint_close(live);
    check("still running after the X server died", true);
  }
  if (wt_fails != 0) { println("{wt_fails} failed"); return 1; }
  return 0;
}
