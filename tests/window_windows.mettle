// Windows part of the window test: Glint's own window and an HWND the app made.
// Under wine, run it on a private Xvfb (`mbuild wintest`), never the real screen.
import "std/io";
import "glint/glint";
import "window_common";

extern fn wt_CreateWindowExW(ex: uint32, cls: uint16*, title: uint16*, style: uint32, x: int32, y: int32, w: int32, h: int32, parent: int64, menu: int64, inst: int64, param: int64) -> int64 = "CreateWindowExW";
extern fn wt_DestroyWindow(hwnd: int64) -> int32 = "DestroyWindow";

export fn wt_main() -> int32 {
  own_window(GLINT_BACKEND_WGL, "own window WGL");
  // A plain window "the app" made: a STATIC control as a top-level popup, 120x90 client.
  var cls: uint16[8];
  var name: string = "STATIC";
  for i in 0..6 { cls[i] = (uint16)name[i]; }
  cls[6] = 0;
  var hwnd: int64 = wt_CreateWindowExW(0, &cls[0], &cls[0], 2147483648 | 268435456, 0, 0, 120, 90, 0, 0, 0, 0);   // WS_POPUP | WS_VISIBLE
  check("app HWND", hwnd != 0);
  bad_handle(GLINT_BACKEND_WGL, "existing WGL", 0x7FFFFFF0);
  existing_window(GLINT_BACKEND_WGL, "existing WGL", hwnd);
  wt_DestroyWindow(hwnd);
  if (wt_fails != 0) { println("{wt_fails} failed"); return 1; }
  return 0;
}
