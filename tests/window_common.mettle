// Shared checks for the window tests.
import "std/io";
import "glint/glint";

export var wt_fails: int32 = 0;

export fn check(name: string, ok: bool) {
  if (ok) { println("ok   {name}"); } else { print("FAIL {name}: "); print_cstr(glint_error()); println(""); wt_fails += 1; }
}

export fn near(a: uint32, b: uint32) -> bool {
  for s in 0..4 {
    var sh: uint32 = (uint32)(s * 8);
    var d: int32 = (int32)((a >> sh) & 255) - (int32)((b >> sh) & 255);
    if (d < -3 || d > 3) { return false; }
  }
  return true;
}

// Clear to blue, read it back before the swap, then swap.
export fn draw_check(ctx: GlintContext*, label: string) {
  glClearColor(0.0, 0.0, 1.0, 1.0);
  glClear(GL_COLOR_BUFFER_BIT);
  var px: uint32 = glint_read_pixel(ctx, 5, 5);
  check("{label}: pixel is blue", near(px, 0xFF0000FF));
  glint_swap(ctx);
  check("{label}: no GL error", glGetError() == 0);
}

// Glint's own window: open, draw, events, resize, vsync, close.
export fn own_window(backend: int32, label: string) {
  var cfg: GlintConfig = glint_config();
  cfg.backend = backend;
  cfg.vsync = 0;
  var ctx: GlintContext* = glint_open_window("glint test", 160, 120, &cfg);
  check("{label}: open", ctx != 0);
  if (ctx == 0) { return; }
  println("     {glint_backend_name(ctx)} GL {glint_gl_version(ctx)}");
  check("{label}: backend", ctx->backend == backend);
  check("{label}: size", ctx->width == 160 && ctx->height == 120);
  draw_check(ctx, label);
  var ev: GlintEvent;
  while (glint_poll(ctx, &ev)) { }
  var age: int32 = glint_buffer_age(ctx);
  var r: int32[4] = [10, 10, 20, 20];
  glClear(GL_COLOR_BUFFER_BIT);
  var dmg: bool = glint_swap_damage(ctx, &r[0], 1);
  println("     buffer age {age}, damage swap {dmg}");
  check("{label}: damage swap leaves no GL error", glGetError() == 0 && age >= 0);
  var sh: GlintContext* = glint_open_shared(ctx, 8, 8);
  check("{label}: shared context", sh != 0);
  if (sh != 0) {
    glClearColor(1.0, 1.0, 0.0, 1.0);
    glClear(GL_COLOR_BUFFER_BIT);
    glFinish();
    var tex: uint32 = glint_color_texture(sh);
    check("{label}: back to the window context", glint_make_current(ctx));
    var fb: uint32 = 0;
    glGenFramebuffers(1, &fb);
    glBindFramebuffer(GL_READ_FRAMEBUFFER, fb);
    glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
    var p4: uint8[4];
    glReadPixels(1, 1, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, (rawptr)&p4[0]);
    check("{label}: window context sees the shared texture", p4[0] == 255 && p4[1] == 255 && p4[2] == 0);
    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
    glDeleteFramebuffers(1, &fb);
    glint_close(sh);
    glint_make_current(ctx);
  }
  check("{label}: resize", glint_resize(ctx, 200, 150));
  glint_set_vsync(ctx, 0);
  glint_close(ctx);
}

// A window handle that does not exist must fail with 0, not end the program.
export fn bad_handle(backend: int32, label: string, handle: int64) {
  var cfg: GlintConfig = glint_config();
  cfg.backend = backend;
  var ctx: GlintContext* = glint_open_existing(handle, &cfg);
  check("{label}: bad handle returns 0", ctx == 0);
  if (ctx != 0) { glint_close(ctx); }
}

export fn existing_window(backend: int32, label: string, handle: int64) {
  var cfg: GlintConfig = glint_config();
  cfg.backend = backend;
  var ctx: GlintContext* = glint_open_existing(handle, &cfg);
  check("{label}: open on app window", ctx != 0);
  if (ctx == 0) { return; }
  check("{label}: size from window", ctx->width == 120 && ctx->height == 90);
  draw_check(ctx, label);
  glint_close(ctx);
}
