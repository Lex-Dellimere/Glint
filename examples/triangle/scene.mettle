// LearnOpenGL "Hello Triangle": one orange triangle from a VBO and a VAO.
import "glint/glint";
import "../common/ex_run";

var prog: uint32 = 0;
var vao: uint32 = 0;

export fn triangle_setup() -> bool {
  prog = glint_program(
    "#version 330 core\nlayout (location = 0) in vec3 aPos;\nvoid main() {{ gl_Position = vec4(aPos, 1.0); }\n",
    "#version 330 core\nout vec4 FragColor;\nvoid main() {{ FragColor = vec4(1.0, 0.5, 0.2, 1.0); }\n");
  if (prog == 0) { return false; }
  var v: float32[9] = [-0.5, -0.5, 0.0,  0.5, -0.5, 0.0,  0.0, 0.5, 0.0];
  var layout: int32[1] = [3];
  vao = ex_mesh(&v[0], 9, &layout[0], 1);
  return true;
}

export fn triangle_draw(ctx: GlintContext*, t: float32) {
  glClearColor(0.2, 0.3, 0.3, 1.0);
  glClear(GL_COLOR_BUFFER_BIT);
  glUseProgram(prog);
  glBindVertexArray(vao);
  glDrawArrays(GL_TRIANGLES, 0, 3);
}
